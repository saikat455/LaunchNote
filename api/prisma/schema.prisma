generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

enum PostCategory {
  NEW
  IMPROVED
  FIXED
  ANNOUNCEMENT
}

enum FeedbackStatus {
  UNDER_REVIEW
  PLANNED
  IN_PROGRESS
  DONE
  DECLINED
}

enum AnalyticsEventType {
  PAGE_VIEW
  WIDGET_OPEN
  WIDGET_CLICK
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  name         String
  passwordHash String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  memberships  ProjectMember[]
  posts        Post[]
}

model Project {
  id               String           @id @default(cuid())
  name             String
  slug             String           @unique
  description      String?
  websiteUrl       String?
  widgetLastSeenAt DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  members          ProjectMember[]
  posts            Post[]
  feedback         Feedback[]
  events           AnalyticsEvent[]
  invites          ProjectInvite[]
}

model ProjectMember {
  id        String   @id @default(cuid())
  role      Role     @default(MEMBER)
  userId    String
  projectId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, projectId])
}

model ProjectInvite {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  role        Role      @default(MEMBER)
  projectId   String
  createdById String?
  usedById    String?
  usedAt      DateTime?
  expiresAt   DateTime
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([projectId, usedAt])
}

model Post {
  id           String       @id @default(cuid())
  title        String
  slug         String
  content      String       @default("")
  excerpt      String       @default("")
  category     PostCategory @default(NEW)
  status       PostStatus   @default(DRAFT)
  publishedAt  DateTime?
  scheduledFor DateTime?
  projectId    String
  authorId     String?
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author       User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  feedback     Feedback[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([projectId, slug])
  @@index([projectId, status, publishedAt])
  @@index([status, scheduledFor])
}

model Feedback {
  id              String            @id @default(cuid())
  title           String
  description     String            @default("")
  status          FeedbackStatus    @default(UNDER_REVIEW)
  authorName      String
  authorEmail     String?
  voteCount       Int               @default(0)
  commentCount    Int               @default(0)
  roadmapPosition Int               @default(0)
  projectId       String
  postId          String?
  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  post            Post?             @relation(fields: [postId], references: [id], onDelete: SetNull)
  votes           FeedbackVote[]
  comments        FeedbackComment[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([projectId, status, roadmapPosition])
  @@index([projectId, voteCount])
}

model FeedbackVote {
  id         String   @id @default(cuid())
  voterId    String
  feedbackId String
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  // one vote per visitor per idea, enforced by the database
  @@unique([feedbackId, voterId])
}

model FeedbackComment {
  id         String   @id @default(cuid())
  body       String
  authorName String
  isTeam     Boolean  @default(false)
  userId     String?
  feedbackId String
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([feedbackId, createdAt])
}

model AnalyticsEvent {
  id        String             @id @default(cuid())
  type      AnalyticsEventType
  page      String             @default("")
  ref       String?
  visitorId String
  projectId String
  project   Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now())

  @@index([projectId, type, createdAt])
  @@index([projectId, page, ref])
}