generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

enum PostCategory {
  NEW
  IMPROVED
  FIXED
  ANNOUNCEMENT
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  name         String
  passwordHash String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  memberships  ProjectMember[]
  posts        Post[]
}

model Project {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  description String?
  websiteUrl  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  members     ProjectMember[]
  posts       Post[]
  feedback    Feedback[]
}

model ProjectMember {
  id        String   @id @default(cuid())
  role      Role     @default(MEMBER)
  userId    String
  projectId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, projectId])
}

model Post {
  id          String       @id @default(cuid())
  title       String
  slug        String
  content     String       @default("")
  excerpt     String       @default("")
  category    PostCategory @default(NEW)
  status      PostStatus   @default(DRAFT)
  publishedAt DateTime?
  projectId   String
  authorId    String?
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author      User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([projectId, slug])
  @@index([projectId, status, publishedAt])
}

enum FeedbackStatus {
  UNDER_REVIEW
  PLANNED
  IN_PROGRESS
  DONE
  DECLINED
}

model Feedback {
  id           String            @id @default(cuid())
  title        String
  description  String            @default("")
  status       FeedbackStatus    @default(UNDER_REVIEW)
  authorName   String
  authorEmail  String?
  voteCount    Int               @default(0)
  commentCount Int               @default(0)
  projectId    String
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  votes        FeedbackVote[]
  comments     FeedbackComment[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([projectId, status])
  @@index([projectId, voteCount])
}

model FeedbackVote {
  id         String   @id @default(cuid())
  voterId    String
  feedbackId String
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  // one vote per visitor per idea, enforced by the database
  @@unique([feedbackId, voterId])
}

model FeedbackComment {
  id         String   @id @default(cuid())
  body       String
  authorName String
  isTeam     Boolean  @default(false)
  userId     String?
  feedbackId String
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([feedbackId, createdAt])
}